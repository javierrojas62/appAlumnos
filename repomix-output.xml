package controlador;

import entidad.Alumno;
import entidad.Carrera;
import jakarta.ejb.EJB;
import jakarta.servlet.ServletException;
import jakarta.servlet.annotation.WebServlet;
import jakarta.servlet.http.HttpServlet;
import jakarta.servlet.http.HttpServletRequest;
import jakarta.servlet.http.HttpServletResponse;
import java.io.IOException;
import sesion.AlumnoFacade;
import sesion.CarreraFacade;

@WebServlet(name = "Manejador",
        loadOnStartup = 1,
        urlPatterns = {"/SolicitarDatos", "/AgregarAlumno", "/Listar"})
public class Manejador extends HttpServlet {

    @EJB
    private AlumnoFacade alumnoF;

    @EJB
    private CarreraFacade carreraF;

    protected void processRequest(HttpServletRequest request, HttpServletResponse response)
            throws ServletException, IOException {

        request.setCharacterEncoding("UTF-8");
        String pathUsuario = request.getServletPath();
        String url = null;

        switch (pathUsuario) {

            case "/SolicitarDatos":
                // Le paso las carreras a la vista para armar el <select>
                request.setAttribute("carreras", carreraF.findAll());
                url = "/WEB-INF/vista/SolicitarDatos.jsp";
                break;

            case "/AgregarAlumno":
                Alumno a = new Alumno();
                a.setRegistro(request.getParameter("registro"));   // String, sin parseInt
                a.setNombre(request.getParameter("nombre"));
                Carrera c = carreraF.find(Integer.parseInt(request.getParameter("carrera")));
                a.setCarreraIdcarrera(c);                          // objeto, no texto
                alumnoF.create(a);
                // Después de guardar, muestro el listado actualizado
                response.sendRedirect(request.getContextPath() + "/Listar");
                return;

            case "/Listar":
                request.setAttribute("lista", alumnoF.findAll());
                url = "/WEB-INF/vista/Listar.jsp";
                break;
        }

        request.getRequestDispatcher(url).forward(request, response);
    }

    @Override
    protected void doGet(HttpServletRequest request, HttpServletResponse response)
            throws ServletException, IOException {
        processRequest(request, response);
    }

    @Override
    protected void doPost(HttpServletRequest request, HttpServletResponse response)
            throws ServletException, IOException {
        processRequest(request, response);
    }
}
